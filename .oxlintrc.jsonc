{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // The ESLint rule set this replaces, plus `unicorn`, `import`, and
  // `promise`, which it never had. The migration itself landed parity-only so
  // that the two diffs stayed reviewable apart from each other.
  //
  // `suspicious` is enabled as a warning rather than an error: it surfaces
  // roughly ninety findings that are worth seeing but are not defects, and
  // making them blocking would have meant either a very large mechanical diff
  // or a pile of suppressions.
  //
  // Scoping mirrors the old config layout: the root `eslint.config.mjs` used
  // `library.mjs` + `json.mjs` with no React or Next rules, and only the four
  // Next apps opted into `next.mjs`.
  "plugins": ["eslint", "typescript", "oxc", "unicorn", "import", "promise"],
  // ESLint plugins loaded through Oxlint's JS bridge, for rules Oxlint has no
  // native equivalent for. They are resolved relative to this file.
  "jsPlugins": ["@stylexjs/eslint-plugin", "eslint-plugin-storybook", "eslint-plugin-turbo"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true,
  },
  "globals": {
    "React": "readonly",
    "JSX": "readonly",
  },
  "options": {
    // Matches `linterOptions.reportUnusedDisableDirectives` in the ESLint
    // config, so stale suppressions surface instead of accumulating. ESLint's
    // `true` means "warn"; Oxlint takes the severity directly.
    "reportUnusedDisableDirectives": "warn",
  },
  "rules": {
    // Ported verbatim from `packages/eslint-config/library.mjs`.
    "no-unused-vars": [
      "error",
      {
        "vars": "all",
        "args": "after-used",
        "ignoreRestSiblings": true,
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none",
      },
    ],
    // `tseslint.configs.recommended`. Oxlint files most of these outside the
    // `correctness` category, so enabling the plugin alone does not reproduce
    // the old behaviour and they have to be listed. Two rules in that preset,
    // `no-array-constructor` and `no-unused-expressions`, have no Oxlint
    // implementation and are lost; the base `eslint` versions of both still
    // run via `correctness`.
    // Every member of that preset is listed exactly once, in the alphabetised
    // block below. Listing them here as well is not additive: `rules` is a
    // JSON object, so a repeated key silently takes its last value rather than
    // merging. That is not hypothetical — it had turned
    // `typescript/no-require-imports` off across the whole repository.
    // Restored via the JS bridge above.
    "turbo/no-undeclared-env-vars": "error",
    // ── Ratchet ──────────────────────────────────────────────────────────
    // Every rule below already passes on the current tree, so enabling them
    // costs no churn. They exist to stop regressions rather than to force a
    // cleanup, which is why the list is derived from what is verifiably clean
    // rather than from whole categories: `style` alone reports 25,127 findings
    // and mostly duplicates the formatter, and `restriction` bans ordinary
    // modern JavaScript (`no-var`, `no-optional-chaining`, `no-async-await`).
    // Core JavaScript correctness rules that the tree already satisfies.
    "accessor-pairs": "error",
    "array-callback-return": "error",
    "block-scoped-var": "error",
    "constructor-super": "error",
    "for-direction": "error",
    "getter-return": "error",
    "max-nested-callbacks": "error",
    "no-alert": "error",
    "no-array-constructor": "error",
    "no-async-promise-executor": "error",
    "no-caller": "error",
    "no-case-declarations": "error",
    "no-class-assign": "error",
    "no-compare-neg-zero": "error",
    "no-cond-assign": "error",
    "no-const-assign": "error",
    "no-constructor-return": "error",
    "no-control-regex": "error",
    "no-debugger": "error",
    "no-delete-var": "error",
    "no-div-regex": "error",
    "no-dupe-class-members": "error",
    "no-dupe-else-if": "error",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-empty": "error",
    "no-empty-character-class": "error",
    "no-empty-pattern": "error",
    "no-empty-static-block": "error",
    "no-eval": "error",
    "no-ex-assign": "error",
    "no-extend-native": "error",
    "no-extra-bind": "error",
    "no-extra-boolean-cast": "error",
    "no-fallthrough": "error",
    "no-func-assign": "error",
    "no-global-assign": "error",
    "no-implied-eval": "error",
    "no-import-assign": "error",
    "no-inner-declarations": "error",
    "no-invalid-regexp": "error",
    "no-irregular-whitespace": "error",
    "no-iterator": "error",
    "no-loop-func": "error",
    "no-loss-of-precision": "error",
    "no-misleading-character-class": "error",
    "no-new": "error",
    "no-new-native-nonconstructor": "error",
    "no-new-wrappers": "error",
    "no-nonoctal-decimal-escape": "error",
    "no-obj-calls": "error",
    "no-object-constructor": "error",
    "no-promise-executor-return": "error",
    "no-proto": "error",
    "no-prototype-builtins": "error",
    "no-redeclare": "error",
    "no-regex-spaces": "error",
    "no-self-assign": "error",
    "no-self-compare": "error",
    "no-sequences": "error",
    "no-setter-return": "error",
    "no-shadow-restricted-names": "error",
    "no-sparse-arrays": "error",
    "no-this-before-super": "error",
    "no-throw-literal": "error",
    "no-unassigned-vars": "error",
    "no-unexpected-multiline": "error",
    "no-unmodified-loop-condition": "error",
    "no-unneeded-ternary": "error",
    "no-unreachable": "error",
    "no-unsafe-finally": "error",
    "no-unsafe-negation": "error",
    "no-unsafe-optional-chaining": "error",
    "no-unused-labels": "error",
    "no-unused-private-class-members": "error",
    "no-useless-backreference": "error",
    "no-useless-call": "error",
    "no-useless-catch": "error",
    "no-useless-constructor": "error",
    "no-useless-escape": "error",
    "no-useless-rename": "error",
    "no-useless-return": "error",
    "no-with": "error",
    "radix": "error",
    "require-yield": "error",
    "symbol-description": "error",
    "unicode-bom": "error",
    "use-isnan": "error",
    "valid-typeof": "error",
    // TypeScript rules the tree already satisfies. Those needing type
    // information only report under `pnpm lint:type-aware`.
    "typescript/ban-ts-comment": "error",
    "typescript/no-array-delete": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-confusing-non-null-assertion": "error",
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-duplicate-type-constituents": "error",
    "typescript/no-dynamic-delete": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-for-in-array": "error",
    "typescript/no-implied-eval": "error",
    "typescript/no-invalid-void-type": "error",
    "typescript/no-meaningless-void-operator": "error",
    "typescript/no-misused-new": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-mixed-enums": "error",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-asserted-nullish-coalescing": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-redundant-type-constituents": "error",
    // 7 sites, all CommonJS tool configs that must use `require`; the
    // `overrides` entry below exempts them. `--type-aware` does not apply
    // `overrides`, so `lint:node:type-aware` passes `--allow` for this rule on
    // the command line. A second config file cannot express that: `extends`
    // inherits neither `ignorePatterns` nor `overrides`, so the type-aware run
    // would start linting generated output.
    "typescript/no-require-imports": "error",
    "typescript/no-this-alias": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    "typescript/no-unnecessary-parameter-property-assignment": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unnecessary-type-parameters": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-unsafe-unary-minus": "error",
    "typescript/no-useless-default-assignment": "error",
    "typescript/no-useless-empty-export": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-enum-initializers": "error",
    "typescript/prefer-includes": "error",
    "typescript/prefer-literal-enum-member": "error",
    "typescript/prefer-namespace-keyword": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/prefer-ts-expect-error": "error",
    "typescript/related-getter-setter-pairs": "error",
    "typescript/require-array-sort-compare": "error",
    "typescript/return-await": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/triple-slash-reference": "error",
    "typescript/unbound-method": "error",
    // Modern-JavaScript correctness rules, restricted to ones that describe
    // a defect rather than a style preference.
    "unicorn/consistent-assert": "error",
    "unicorn/consistent-empty-array-spread": "error",
    "unicorn/escape-case": "error",
    "unicorn/new-for-builtins": "error",
    "unicorn/no-abusive-eslint-disable": "error",
    "unicorn/no-accessor-recursion": "error",
    "unicorn/no-array-fill-with-reference-type": "error",
    "unicorn/no-await-in-promise-methods": "error",
    "unicorn/no-confusing-array-with": "error",
    "unicorn/no-document-cookie": "error",
    "unicorn/no-hex-escape": "error",
    "unicorn/no-instanceof-array": "error",
    "unicorn/no-instanceof-builtins": "error",
    "unicorn/no-invalid-fetch-options": "error",
    "unicorn/no-invalid-remove-event-listener": "error",
    "unicorn/no-length-as-slice-end": "error",
    "unicorn/no-magic-array-flat-depth": "error",
    "unicorn/no-negation-in-equality-check": "error",
    "unicorn/no-new-array": "error",
    "unicorn/no-new-buffer": "error",
    "unicorn/no-single-promise-in-promise-methods": "error",
    "unicorn/no-static-only-class": "error",
    "unicorn/no-thenable": "error",
    "unicorn/no-this-assignment": "error",
    "unicorn/no-typeof-undefined": "error",
    "unicorn/no-unnecessary-array-flat-depth": "error",
    "unicorn/no-unnecessary-array-splice-count": "error",
    "unicorn/no-unnecessary-await": "error",
    "unicorn/no-unnecessary-slice-end": "error",
    "unicorn/no-unreadable-iife": "error",
    "unicorn/no-useless-error-capture-stack-trace": "error",
    "unicorn/no-useless-fallback-in-spread": "error",
    "unicorn/no-useless-length-check": "error",
    "unicorn/no-useless-promise-resolve-reject": "error",
    "unicorn/no-useless-switch-case": "error",
    "unicorn/prefer-add-event-listener": "error",
    "unicorn/prefer-array-find": "error",
    "unicorn/prefer-array-flat": "error",
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/prefer-array-some": "error",
    "unicorn/prefer-blob-reading-methods": "error",
    "unicorn/prefer-code-point": "error",
    "unicorn/prefer-date-now": "error",
    "unicorn/prefer-dom-node-dataset": "error",
    "unicorn/prefer-math-min-max": "error",
    "unicorn/prefer-modern-math-apis": "error",
    "unicorn/prefer-prototype-methods": "error",
    "unicorn/prefer-regexp-test": "error",
    "unicorn/prefer-set-has": "error",
    "unicorn/prefer-set-size": "error",
    "unicorn/prefer-string-starts-ends-with": "error",
    "unicorn/require-module-specifiers": "error",
    "unicorn/require-number-to-fixed-digits-argument": "error",
    "unicorn/require-post-message-target-origin": "error",
    // Oxc's own bug-pattern rules: comparison mistakes, bad built-in
    // arguments, unreachable or erased operations.
    "oxc/approx-constant": "error",
    "oxc/bad-array-method-on-arguments": "error",
    "oxc/bad-bitwise-operator": "error",
    "oxc/bad-char-at-comparison": "error",
    "oxc/bad-match-all-arg": "error",
    "oxc/bad-min-max-func": "error",
    "oxc/bad-object-literal-comparison": "error",
    "oxc/bad-replace-all-arg": "error",
    "oxc/branches-sharing-code": "error",
    "oxc/const-comparisons": "error",
    "oxc/double-comparisons": "error",
    "oxc/erasing-op": "error",
    "oxc/misrefactored-assign-op": "error",
    "oxc/missing-throw": "error",
    "oxc/no-accumulating-spread": "error",
    "oxc/no-async-endpoint-handlers": "error",
    "oxc/no-const-enum": "error",
    "oxc/no-map-spread": "error",
    "oxc/number-arg-out-of-range": "error",
    "oxc/only-used-in-recursion": "error",
    "oxc/uninvoked-array-callback": "error",
    // Module-graph integrity: unresolved imports, cycles, self-imports.
    "import/default": "error",
    "import/namespace": "error",
    "import/no-absolute-path": "error",
    "import/no-amd": "error",
    "import/no-cycle": "error",
    "import/no-empty-named-blocks": "error",
    "import/no-named-as-default": "error",
    "import/no-self-import": "error",
    "import/no-webpack-loader-syntax": "error",
    // Promise misuse not already covered by the type-aware rules.
    "promise/catch-or-return": "error",
    "promise/no-callback-in-promise": "error",
    "promise/no-new-statics": "error",
    "promise/no-promise-in-callback": "error",
    "promise/spec-only": "error",
    "promise/valid-params": "error",
    // `no-floating-promises` and `no-misused-promises` are type-aware and
    // listed once in the alphabetised TypeScript block above; they need
    // `oxlint-tsgolint` and so only report under `pnpm lint:type-aware`,
    // which is a separate script and a separate CI job so the default lint
    // stays fast.
    // `--type-aware` switches on every type-aware correctness rule, not just
    // the ones named here, so each is stated explicitly.
    //
    // Now clean and enforced. `no-misused-spread` is the important one: it
    // caught `...defaultConfig.webServer` in 21 Playwright configs, where
    // Playwright types `webServer` as a config *or an array of them*, so the
    // spread would have produced numeric index keys rather than server
    // options whenever that union resolved to the array side. Fixed by
    // exporting the narrow value from `@stylexswc/playwright`.
    "typescript/no-misused-spread": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-template-expression": "error",
    // Still reporting. Counts are from the current tree; these are genuine
    // findings rather than false positives, and each wants its own change.
    // 93 sites, 70 of them test mocks asserting partial objects. Overrides
    // cannot scope it: `--type-aware` ignores the `overrides` block (see
    // `no-require-imports` below), so this is all-or-nothing.
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-unnecessary-type-conversion": "error", //         40
    // 10 sites, every one an async signature required by an external
    // contract: Jest's `SyncTransformer.processAsync`, the webpack and
    // turbopack loader signatures, Astro's `astro:config:setup`, and Farm's
    // `transformHtml.executor`. Dropping `async` would change the return type.
    "typescript/require-await": "off",
    "typescript/consistent-return": "error", //                       8
    "typescript/non-nullable-type-assertion-style": "error", //       6
    // 5 sites: the same CommonJS configs plus deliberate lazy `require`
    // calls used to defer loading optional peer dependencies.
    "typescript/no-var-requires": "off",
    // 4 sites, all memoized promise accessors (`lazyPostCSSPromise ||= ...`).
    // Marking them `async` would return a new promise per call and defeat the
    // memoisation the pattern exists for.
    "typescript/promise-function-async": "off",
    "typescript/use-unknown-in-catch-callback-variable": "error", //  2
    "typescript/no-deprecated": "error", //                           2
    "typescript/await-thenable": "error", //                          1
    "typescript/restrict-template-expressions": "error", //           1
    // `typescript/no-require-imports` is enforced above and suppressed for the
    // type-aware run only, via `--allow` in `lint:node:type-aware`. Repeating
    // the `"off"` here disabled it for both runs, because a duplicate key in
    // this object wins rather than merges.
    // 1 site: a `vi.mock` class stub that exists only to record constructor
    // arguments.
    "typescript/no-extraneous-class": "error",
  },
  "ignorePatterns": [
    "**/dist",
    "**/node_modules",
    "**/output",
    // The ESLint config wrote `**/fixture`, which never matched the actual
    // `fixtures` directories and left them being linted by accident.
    "**/fixture",
    "**/fixtures",
    "**/performance_fixture",
    "**/perf_fixtures",
    "**/__swc_snapshots__",
    "**/__snapshots__",
    "**/.next",
    "**/visual-tests",
    "**/coverage",
    "**/next-env.d.ts",
    "**/storybook-static",
    "**/playwright-report",
    "**/test-results",
    "**/.turbo",
  ],
  "overrides": [
    {
      // StyleX style-object validation, restored through the JS bridge.
      "files": [
        "**/*.stylex.ts",
        "**/*.stylex.tsx",
        "apps/**/*.tsx",
        "packages/design-system/**/*.tsx",
      ],
      "rules": {
        "@stylexjs/valid-styles": "error",
      },
    },
    {
      // Storybook rules, restored through the JS bridge.
      "files": ["**/*.stories.ts", "**/*.stories.tsx"],
      "rules": {
        "storybook/default-exports": "error",
        "storybook/story-exports": "error",
        "storybook/no-redundant-story-name": "warn",
        "storybook/prefer-pascal-case": "warn",
      },
    },
    {
      // CommonJS tool configuration. These files must use `require`, and the
      // old config sprinkled per-line disables through them to say so. Running
      // Oxlint once from the root also reaches root-level config files that
      // the previous per-package ESLint fan-out never linted at all.
      "files": [
        "**/*.config.js",
        "**/*.config.cjs",
        "**/.*rc.js",
        "**/jest.setup.js",
        "**/scripts/**/*.js",
      ],
      "rules": {
        "typescript/no-require-imports": "off",
      },
    },
    {
      // Only the Next apps used `eslint-config-next`, which is where the
      // React, accessibility, and Next rules came from.
      "files": ["apps/nextjs-*/**"],
      "plugins": ["react", "jsx-a11y", "nextjs"],
      "jsPlugins": ["@stylexjs/eslint-plugin"],
      "rules": {
        // React 19 with the automatic JSX runtime.
        "react/react-in-jsx-scope": "off",
        // Explicitly disabled by `next.mjs`; these apps use the app router.
        "nextjs/no-html-link-for-pages": "off",
        // `eslint-config-next` bundles the React Hooks rules; Oxlint exposes
        // them under the `react` namespace rather than `react-hooks`.
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "warn",
      },
    },
    {
      // The five rules the ESLint config enabled, scoped to the suites that
      // actually run under Jest: the transformer product and the four Next
      // example apps that exercise it.
      "files": ["packages/jest/__tests__/**", "apps/nextjs-*/__tests__/**"],
      "plugins": ["jest"],
      "rules": {
        "jest/no-disabled-tests": "warn",
        "jest/no-focused-tests": "error",
        "jest/no-identical-title": "error",
        "jest/prefer-to-have-length": "warn",
        "jest/valid-expect": "error",
      },
    },
    {
      // Everything else runs under Vitest. The same five rules, from the
      // vitest plugin: applying the jest ones here misreports Vitest-only
      // API, notably `expect(value, message)`, which Jest does not accept.
      "files": [
        "crates/stylex-rs-compiler/__test__/**",
        "packages/*/__tests__/**",
        "apps/example-storybook/**/*.{test,spec}.{ts,tsx}",
      ],
      "excludeFiles": ["packages/jest/__tests__/**"],
      "plugins": ["vitest"],
      "rules": {
        "vitest/no-disabled-tests": "warn",
        "vitest/no-focused-tests": "error",
        "vitest/no-identical-title": "error",
        "vitest/prefer-to-have-length": "warn",
        "vitest/valid-expect": "error",
        // Adopted here rather than in the migration commit, since none of
        // these had an ESLint counterpart.
        //
        // `require-mock-type-parameters` is a warning, not an error: each of
        // its 27 sites needs a generic signature chosen from how that mock is
        // actually used, and inventing them mechanically would produce types
        // that typecheck without describing anything.
        "vitest/require-mock-type-parameters": "warn",
        "vitest/prefer-snapshot-hint": "warn",
        "vitest/no-conditional-expect": "error",
      },
    },
  ],
}
