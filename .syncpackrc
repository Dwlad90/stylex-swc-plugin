{
  "$schema": "./node_modules/syncpack/schema.json",
  "indent": "  ",
  "semverGroups": [
    {
      "label": "TypeScript and its Oxlint type-aware companion are pinned exactly and updated as a pair",
      "dependencies": ["typescript", "oxlint-tsgolint"],
      "dependencyTypes": ["dev", "prod"],
      "packages": ["**"],
      "range": ""
    }
  ],
  "sortAz": [
    "contributors",
    "private",
    "dependencies",
    "devDependencies",
    "keywords",
    "peerDependencies",
    "resolutions",
    "scripts"
  ],
  "sortFirst": [
    "name",
    "description",
    "version",
    "private",
    "author",
    "license",
    "sideEffects",
    "module",
    "types",
    "exports",
    "imports",
    "files",
    "publishConfig",
    "scripts",
    "volta",
    "config",
    "dependencies",
    "devDependencies",
    "peerDependencies"
  ],
  "source": [
    "**/package.json",
    "!**/node_modules/**",
    "!crates/stylex-path-resolver/fixtures/**",
    "!crates/stylex-transform/src/shared/structures/tests/fixtures/**",
    "!crates/stylex-transform/tests/__virtual__/**",
    "!crates/stylex-transform/tests/fixture/**",
    "!packages/postcss-plugin/__tests__/__auto_discovery_fixtures__/**",
    "!crates/stylex-rs-compiler/npm/**",
    "!**/.next/**"
  ],
  "versionGroups": [
    {
      "label": "TypeScript must resolve to one identical exact version everywhere",
      "dependencies": ["typescript", "oxlint-tsgolint"],
      "dependencyTypes": ["dev", "prod"],
      "packages": ["**"],
      "preferVersion": "highestSemver"
    },
    {
      "label": "Accept everything except peerDependencies",
      "dependencyTypes": [
        "!dev",
        "!prod",
        "!resolutions",
        "!overrides",
        "!pnpmOverrides"
      ],
      "isIgnored": true
    }
  ],
  "customTypes": {
    "pnpmOverridesLegacy": {
      "strategy": "versionsByName",
      "path": "pnpm.overrides"
    }
  }
}
