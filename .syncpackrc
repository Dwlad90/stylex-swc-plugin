{
  "$schema": "./node_modules/syncpack/schema.json",
  "indent": "  ",
  "semverGroups": [
    {
      "label": "TypeScript and its Oxlint type-aware companion are pinned exactly and updated as a pair",
      "dependencies": ["typescript", "oxlint-tsgolint"],
      "dependencyTypes": ["dev", "prod"],
      "packages": ["**"],
      "range": ""
    }
  ],
  "sortAz": [
    "contributors",
    "private",
    "dependencies",
    "devDependencies",
    "keywords",
    "peerDependencies",
    "resolutions",
    "scripts"
  ],
  "sortFirst": [
    "name",
    "description",
    "version",
    "private",
    "author",
    "license",
    "sideEffects",
    "module",
    "types",
    "exports",
    "imports",
    "files",
    "publishConfig",
    "scripts",
    "volta",
    "config",
    "dependencies",
    "devDependencies",
    "peerDependencies"
  ],
  "source": [
    "package.json",
    "*/*/package.json",
    "!*/fixtures/*"
  ],
  "versionGroups": [
    {
      "label": "TypeScript must resolve to one identical exact version everywhere",
      "dependencies": ["typescript", "oxlint-tsgolint"],
      "dependencyTypes": ["dev", "prod"],
      "packages": ["**"],
      "preferVersion": "highestSemver"
    },
    {
      "label": "Accept everything except peerDependencies",
      "dependencyTypes": [
        "!dev",
        "!prod",
        "!resolutions",
        "!overrides",
        "!pnpmOverrides"
      ],
      "isIgnored": true
    }
  ],
  "customTypes": {
    "pnpmOverridesLegacy": {
      "strategy": "versionsByName",
      "path": "pnpm.overrides"
    }
  }
}
