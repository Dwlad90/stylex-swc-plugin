{
  "$schema": "./node_modules/syncpack/schema.json",
  "indent": "  ",
  "semverGroups": [
    {
      "label": "Ranges are catalogued, not linted -- see `catalogs` in pnpm-workspace.yaml",
      "dependencyTypes": ["**"],
      "packages": ["**"],
      "isIgnored": true
    }
  ],
  "sortAz": [
    "contributors",
    "private",
    "dependencies",
    "devDependencies",
    "keywords",
    "peerDependencies",
    "resolutions",
    "scripts"
  ],
  "sortFirst": [
    "name",
    "description",
    "version",
    "private",
    "author",
    "license",
    "sideEffects",
    "module",
    "types",
    "exports",
    "imports",
    "files",
    "publishConfig",
    "scripts",
    "volta",
    "config",
    "dependencies",
    "devDependencies",
    "peerDependencies"
  ],
  "source": [
    "**/package.json",
    "!**/node_modules/**",
    "!crates/stylex-path-resolver/fixtures/**",
    "!crates/stylex-transform/src/shared/structures/tests/fixtures/**",
    "!crates/stylex-transform/tests/__virtual__/**",
    "!crates/stylex-transform/tests/fixture/**",
    "!packages/postcss-plugin/__tests__/__auto_discovery_fixtures__/**",
    "!crates/stylex-rs-compiler/npm/**",
    "!**/.next/**"
  ],
  "versionGroups": [
    {
      "label": "Versions are catalogued, not linted -- do not restore, see pnpm-workspace.yaml",
      "dependencyTypes": ["**"],
      "packages": ["**"],
      "isIgnored": true
    }
  ],
  "customTypes": {
    "pnpmOverridesLegacy": {
      "strategy": "versionsByName",
      "path": "pnpm.overrides"
    }
  }
}
