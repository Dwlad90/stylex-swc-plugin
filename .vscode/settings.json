{
  "oxc.enable": true,
  "oxc.configPath": ".oxlintrc.jsonc",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "js/ts.validate.enable": true,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "files.exclude": {
    "node_modules": true,
    "**/node_modules": false,
    "**/.cargo/**": true,
    ".claude": true,
    ".gemini": true,
    ".cursor": true,
    "CURSOR.md": true,
    "GEMINI.md": true,
    "CODEX.md": true,
    "CLAUDE.md": true
  },
  "search.exclude": {
    "node_modules": true,
    "**/node_modules": false,
    "**/.cargo/**": true,
    ".claude": true,
    ".gemini": true,
    ".cursor": true,
    "CURSOR.md": true,
    "GEMINI.md": true,
    "CODEX.md": true,
    "CLAUDE.md": true
  },
  "files.watcherExclude": {
    "node_modules": true,
    "**/node_modules": false,
    "**/.cargo/**": true,
    ".claude": true,
    ".gemini": true,
    ".cursor": true,
    "CURSOR.md": true,
    "GEMINI.md": true,
    "CODEX.md": true,
    "CLAUDE.md": true
  },
  "git.ignoreLimitWarning": true,
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  }
}
