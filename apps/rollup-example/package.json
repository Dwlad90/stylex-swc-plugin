{
  "name": "@stylexswc/rollup-example",
  "description": "A simple rollup example to test @stylexswc/rollup-plugin",
  "version": "0.18.5-rc.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "NODE_ENV=production rollup --config ./rollup.config.mjs",
    "serve": "serve --listen 3011 ./dist",
    "start": "pnpx rollup --config ./rollup.config.mjs --watch",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@stylexjs/stylex": "catalog:runtime",
    "react": "catalog:frameworks",
    "react-dom": "catalog:frameworks"
  },
  "devDependencies": {
    "@playwright/test": "catalog:testing",
    "@rollup/plugin-commonjs": "catalog:bundlers",
    "@rollup/plugin-html": "catalog:bundlers",
    "@rollup/plugin-node-resolve": "catalog:bundlers",
    "@rollup/plugin-replace": "catalog:bundlers",
    "@rollup/plugin-swc": "catalog:bundlers",
    "@stylexswc/playwright": "catalog:internal",
    "@stylexswc/rollup-plugin": "catalog:internal",
    "rollup": "catalog:bundlers",
    "rollup-plugin-serve": "catalog:bundlers",
    "serve": "catalog:testing"
  },
  "main": "index.js"
}
