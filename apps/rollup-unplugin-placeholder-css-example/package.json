    "@rollup/plugin-commonjs": "catalog:bundlers",
    "@rollup/plugin-html": "catalog:bundlers",
    "@rollup/plugin-node-resolve": "catalog:bundlers",
    "@rollup/plugin-replace": "catalog:bundlers",
    "@rollup/plugin-swc": "catalog:bundlers",
    "@stylexswc/playwright": "catalog:internal",
    "rollup": "catalog:bundlers",
    "serve": "catalog:testing"
  }
