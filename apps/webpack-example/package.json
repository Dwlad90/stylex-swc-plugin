{
  "name": "@stylexswc/webpack-example",
  "description": "A simple webpack example to test stylexswc/webpack-plugin",
  "version": "0.18.6",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack serve --config ./webpack.config.js --mode development",
    "serve": "serve --listen 3012 ./dist",
    "start": "webpack --watch",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@stylexjs/stylex": "catalog:runtime",
    "react": "catalog:frameworks",
    "react-dom": "catalog:frameworks"
  },
  "devDependencies": {
    "@playwright/test": "catalog:testing",
    "@pmmmwh/react-refresh-webpack-plugin": "catalog:bundlers",
    "@stylexswc/playwright": "catalog:internal",
    "@stylexswc/plugin-shared": "catalog:internal",
    "@stylexswc/postcss-plugin": "catalog:internal",
    "@stylexswc/webpack-plugin": "catalog:internal",
    "@swc/core": "catalog:bundlers",
    "autoprefixer": "catalog:runtime",
    "css-loader": "catalog:bundlers",
    "file-loader": "catalog:bundlers",
    "html-webpack-plugin": "catalog:bundlers",
    "mini-css-extract-plugin": "catalog:bundlers",
    "postcss": "catalog:runtime",
    "postcss-loader": "catalog:bundlers",
    "react-refresh": "catalog:frameworks",
    "serve": "catalog:testing",
    "swc-loader": "catalog:bundlers",
    "webpack": "catalog:bundlers",
    "webpack-cli": "catalog:bundlers",
    "webpack-dev-server": "catalog:bundlers"
  },
  "main": "./dist/index.js"
}
