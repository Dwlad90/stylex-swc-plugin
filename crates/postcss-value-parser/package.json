{
  "name": "@stylexswc/postcss-value-parser",
  "description": "Loose CSS declaration-value scanner that preserves the author's own characters",
  "version": "0.18.4",
  "private": true,
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench": "scripty",
    "clean": "del-cli dist",
    "do:nothing": "exit 0",
    "format": "run-p format:rs format:toml",
    "format:check": "run-p format:rs:check format:toml:check",
    "format:rs": "cargo fmt --all",
    "format:rs:check": "cargo fmt -- --check",
    "format:toml": "taplo format",
    "format:toml:check": "taplo format --check",
    "generate:value-parser-cases": "node scripts/generate-value-parser-cases.mjs | rustfmt --edition 2024 > src/tests/cases.rs",
    "generate:value-parser-cases:check": "node scripts/generate-value-parser-cases.mjs | rustfmt --edition 2024 | diff -u src/tests/cases.rs -",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run generate:value-parser-cases:check && scripty",
    "test:coverage": "scripty",
    "test:flamegraph": "scripty",
    "test:profile": "NODE_ENV=test cargo flamegraph --root --test"
  },
  "config": {
    "scripty": {
      "path": "../../scripts/packages"
    }
  },
  "devDependencies": {
    "@taplo/cli": "catalog:tooling",
    "npm-run-all2": "catalog:tooling",
    "postcss-value-parser": "catalog:tooling"
  },
  "keywords": [
    "css",
    "parser",
    "stylex",
    "swc"
  ]
}
