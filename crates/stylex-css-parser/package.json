{
  "name": "@stylexswc/css-parser",
  "description": "CSS value parser",
  "version": "0.18.2",
  "private": true,
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench": "scripty",
    "clean": "del-cli dist",
    "do:nothing": "exit 0",
    "format": "run-p format:rs format:toml",
    "format:check": "run-p format:rs:check format:toml:check",
    "format:rs": "cargo fmt --all",
    "format:rs:check": "cargo fmt -- --check",
    "format:toml": "taplo format",
    "format:toml:check": "taplo format --check",
    "prepublishOnly": "pnpm run build",
    "test": "NODE_ENV=test cargo nextest run --all-features",
    "test:coverage": "scripty",
    "test:flamegraph": "scripty",
    "test:profile": "NODE_ENV=test cargo flamegraph --root --test"
  },
  "config": {
    "scripty": {
      "path": "../../scripts/packages"
    }
  },
  "devDependencies": {
    "@stylexswc/macros": "0.18.2",
    "@taplo/cli": "^0.7.0",
    "npm-run-all2": "^9.0.3"
  },
  "keywords": [
    "stylex",
    "swc",
    "swc-plugin"
  ],
  "main": "./dist/stylex_path_resolver.wasm"
}
