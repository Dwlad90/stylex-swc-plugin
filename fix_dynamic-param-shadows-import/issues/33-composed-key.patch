+/// The per-node hasher the composed key is built with.
+///
+/// One of these is opened for every expression node, which rules out
+/// [`WideHasher`]: `Xxh3Default` is a *streaming* state -- 64 bytes of
+/// accumulators and a 256-byte staging buffer, zeroed on construction -- and
+/// paying for that per node rather than per key is what a composed walk cannot
+/// afford. Measured on the depth benchmark, the streaming state made one key
+/// 5x more expensive and turned the whole change into a regression for every
+/// depth under ~40, which is all of them under the shipped ceiling of 32.
+///
+/// So a node collects its bytes and hashes them in one shot. What it collects is
+/// small and bounded for almost every shape -- a discriminant, a scalar field or
+/// two, and 16 bytes per child -- so [`INLINE`](Self::INLINE) bytes of stack
+/// cover it without touching the allocator. A wide collection (an object or an
+/// array literal, up to the 128 entries the walk covers at all) spills into a
+/// `Vec`, which allocates only once it is needed and never for a node that fits.
+///
+/// The digest is xxh3's 128-bit one-shot over exactly those bytes, which is the
+/// same construction [`WideHasher::finish_wide`] streams -- identical output for
+/// an identical byte sequence, so the two are interchangeable in strength and
+/// differ only in what they cost to open.
+struct NodeHasher {
+  inline: [u8; Self::INLINE],
+  len: usize,
+  /// Empty unless the node wrote more than [`INLINE`](Self::INLINE) bytes, at
+  /// which point it holds *all* of them -- the inline prefix is copied in, so
+  /// finishing reads one contiguous run either way.
+  spill: Vec<u8>,
+}
+
+impl NodeHasher {
+  /// Sized to cover a node with three children and its own scalar fields without
+  /// spilling: `3 * 16` for the digests and 16 bytes of discriminant, operator,
+  /// context and flags. No expression node in `Expr` has more than three fixed
+  /// children (`CondExpr`), so only the variable-length shapes -- arrays,
+  /// objects, argument lists, template literals, sequences -- reach the spill.
+  const INLINE: usize = 64;
+
+  #[inline]
+  #[inline]
+  fn new() -> Self {
+    Self {
+      inline: [0u8; Self::INLINE],
+      len: 0,
+      spill: Vec::new(),
+    }
+  }
+
+  #[inline]
+  #[inline]
+  fn finish_wide(&self) -> u128 {
+    if self.spill.is_empty() {
+      xxh3_128(&self.inline[..self.len])
+    } else {
+      xxh3_128(&self.spill)
+    }
+  }
