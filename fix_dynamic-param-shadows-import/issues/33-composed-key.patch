+  enabled: bool,
+  digests: FxHashMap<usize, Option<u128>>,
+  /// The addresses in `digests`, in insertion order -- what makes a scope
+  /// unwindable by length.
+  log: Vec<usize>,
+  /// Nodes whose digest was computed rather than reused.
+  ///
+  /// Counted whether or not the cache is enabled, because it is the unit the
+  /// key's cost is stated in: `key_cost_scaling_tests` asserts the curve
+  /// against it, deterministically and without timing anything.
+  visits: u64,
+}
