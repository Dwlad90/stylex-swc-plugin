+/// The discipline that makes a node's address a usable identity.
+///
+/// An address identifies a node only while the node is alive. The cache is
+/// sound because every entry in it was recorded inside a scope that is still
+/// open, for a node reachable from the expression that scope was handed -- and
+/// that expression outlives the scope. These cases pin the two halves of that:
+/// that a scope forgets exactly what it recorded, and that a node allocated
+/// over a freed one does not inherit its digest.
+#[cfg(test)]
+mod cache_scope_tests {
+  use super::{arithmetic_tower, parse_expr};
+  use crate::hash::{ExprHashCache, stable_hash_unspanned, stable_hash_unspanned_cached};
+  use swc_core::ecma::ast::Expr;
+
+  #[test]
+  fn a_scope_forgets_exactly_what_it_recorded() {
+    let outer = arithmetic_tower(4);
+    let inner = arithmetic_tower(4);
+
+    let mut cache = ExprHashCache::new();
+
+    stable_hash_unspanned_cached(&outer, &mut cache);
+    let after_outer = cache.mark();
+
+    stable_hash_unspanned_cached(&inner, &mut cache);
+    assert!(
+      cache.mark() > after_outer,
+      "hashing a second tower recorded nothing"
+    );
+
+    cache.truncate(after_outer);
+    assert_eq!(cache.mark(), after_outer);
+
+    // What the outer scope recorded is still there: re-hashing it costs nothing.
+    cache.reset_visits();
+    stable_hash_unspanned_cached(&outer, &mut cache);
+    assert_eq!(
+      cache.visits(),
+      0,
+      "the surviving scope's entries were dropped"
+    );
+
+    // What the truncated scope recorded is gone: re-hashing it pays in full.
+    cache.reset_visits();
+    stable_hash_unspanned_cached(&inner, &mut cache);
+    assert_eq!(cache.visits(), 9, "the truncated scope's entries survived");
+  }
+
+  #[test]
+  fn a_node_allocated_over_a_freed_one_does_not_inherit_its_digest() {
+    // The failure mode the scope exists to prevent, driven directly: hash a
+    // heap-allocated expression, drop it, and allocate a different one of the
+    // same size, which a size-class allocator will very often place at the same
+    // address. Without the truncation the second read would answer the first
+    // one's digest.
+    //
