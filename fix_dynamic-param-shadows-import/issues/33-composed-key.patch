+impl Hasher for NodeHasher {
+  #[inline]
+  fn write(&mut self, bytes: &[u8]) {
+    if !self.spill.is_empty() {
+      self.spill.extend_from_slice(bytes);
+      return;
+    }
+
+    match self.inline.get_mut(self.len..self.len + bytes.len()) {
+      Some(slot) => {
+        slot.copy_from_slice(bytes);
+        self.len += bytes.len();
+      },
+      None => {
+        // First overflow: carry the prefix across so the spill holds the whole
+        // stream. An empty `bytes` cannot reach here -- a zero-length slice
+        // always fits -- so the spill never becomes non-empty while holding
+        // nothing, which is what `write` reads to decide which half is live.
+        self.spill.reserve(self.len + bytes.len());
+        self.spill.extend_from_slice(&self.inline[..self.len]);
+        self.spill.extend_from_slice(bytes);
