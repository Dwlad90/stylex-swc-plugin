+impl ExprHashCache {
+  /// A cache that retains what it is told, for a caller that scopes it.
+  pub fn new() -> Self {
+    Self::default()
+  }
+
+  /// A cache that retains nothing, for a one-shot hash where every lookup would
+  /// miss. It allocates nothing: neither `FxHashMap` nor `Vec` touches the
+  /// allocator until something is inserted, and nothing ever is.
+  pub fn disabled() -> Self {
+    Self {
+      enabled: false,
