+    // rather than the collision -- it is a real regression test when the
+    // addresses coincide and a tautology when they do not, and it reports which
+    // it was.
+    let mut cache = ExprHashCache::new();
+
+    let mark = cache.mark();
+    let first: Box<Expr> = Box::new(parse_expr("a + 1"));
+    let first_address = std::ptr::from_ref::<Expr>(&first) as usize;
+    stable_hash_unspanned_cached(&first, &mut cache);
+    cache.truncate(mark);
+    drop(first);
+
+    let second: Box<Expr> = Box::new(parse_expr("b + 2"));
+    let second_address = std::ptr::from_ref::<Expr>(&second) as usize;
+
+    assert_eq!(
+      stable_hash_unspanned_cached(&second, &mut cache),
+      stable_hash_unspanned(&second),
