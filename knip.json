{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "ignoreDependencies": [
        "@commitlint/cli",
        "commitizen",
        "cz-conventional-changelog",
        "husky",
        "lint-staged",
        "oxfmt",
        "oxlint-tsgolint",
        "playwright",
        "scripty",
        "shellcheck"
      ]
    },
    "apps/*": {
      "ignoreDependencies": ["react-refresh", "@swc/jest"]
    },
    "apps/example-storybook": {
      "ignoreDependencies": [
        "react-refresh",
        "@swc/jest",
        "@storybook/addon-vitest",
        "@vitejs/plugin-react-swc",
        "@vitest/browser",
        "@vitest/browser-playwright",
        "@vitest/coverage-v8",
        "autoprefixer",
        "postcss-nesting",
        "prop-types",
        "rollup-plugin-jsx-remove-attributes",
        "rollup-plugin-node-externals"
      ]
    },
    "apps/farm-unplugin-example": {
      "playwright": false,
      "ignoreDependencies": ["react-refresh", "@swc/jest", "@farmfe/core", "@farmfe/plugin-react"]
    },
    "apps/solid-unplugin-example": {
      "playwright": false,
      "ignoreDependencies": ["react-refresh", "@swc/jest"]
    },
    "packages/*": {},
    "crates/*": {}
  },
  "ignoreBinaries": ["lint-prepush", "cargo", "rustup", "scripty", "python3"],
  "ignoreDependencies": ["@stylexswc/.*"]
}
