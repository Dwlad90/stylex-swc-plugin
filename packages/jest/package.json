{
  "name": "@stylexswc/jest",
  "description": "Jest transformer for StyleX that compiles CSS-in-JS with the Rust NAPI-RS/SWC compiler, enabling Babel-free StyleX component tests.",
  "version": "0.18.4",
  "private": false,
  "license": "MIT",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "scripty --ts",
    "check:artifacts": "scripty && publint --strict && attw --pack . --ignore-rules cjs-only-exports-default",
    "clean": "del-cli dist",
    "postbuild": "pnpm run check:artifacts",
    "prepublishOnly": "pnpm run build",
    "pretest": "pnpm run build",
    "test": "jest",
    "typecheck": "scripty --ts"
  },
  "config": {
    "scripty": {
      "path": "../../scripts/packages"
    }
  },
  "dependencies": {
    "@stylexswc/rs-compiler": "catalog:internal"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:tooling",
    "@jest/globals": "catalog:testing",
    "@jest/transform": "catalog:testing",
    "@jest/types": "catalog:testing",
    "@stylexswc/typescript-config": "catalog:internal",
    "@swc/jest": "catalog:testing",
    "@types/node": "catalog:types",
    "jest": "catalog:testing",
    "publint": "catalog:tooling"
  },
  "bugs": "https://github.com/Dwlad90/stylex-swc-plugin/issues",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/Dwlad90/stylex-swc-plugin/tree/develop/packages/jest#readme",
  "keywords": [
    "babel-free",
    "css-in-js",
    "css-in-js-testing",
    "jest",
    "jest-transform",
    "jest-transformer",
    "napi-rs",
    "react-testing",
    "rust",
    "stylex",
    "stylex-jest",
    "swc",
    "testing"
  ],
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dwlad90/stylex-swc-plugin.git",
    "directory": "packages/jest"
  },
  "type": "commonjs"
}
