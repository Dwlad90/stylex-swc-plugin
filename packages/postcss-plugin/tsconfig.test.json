{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "__tests__/**/*.mts"
  ]
}