{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".oxlintrc.jsonc",
    "Cargo.toml",
    "clippy.toml",
    "package.json",
    "turbo.json",
    "typings/**"
  ],
  "globalEnv": ["NODE_ENV", "PORT", "STYLEX_DEBUG"],
  "globalPassThroughEnv": [
    "CI_COMMIT_SHA",
    "EXPECTED_TARGETS",
    "GITHUB_ACTOR",
    "GITHUB_SHA",
    "GITHUB_STEP_SUMMARY",
    "ImageOS",
    "ImageVersion",
    "LEFTHOOK",
    "RUNNER_IMAGE"
  ],
  "futureFlags": {
    "errorsOnlyShowHash": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["STYLEX_POSTCSS_DEBUG"],
      "passThroughEnv": ["NEXT_RSPACK"],
      "outputs": ["dist/**/*", "npm/**/*", ".next/**", "!.next/cache/**", "storybook-static/**/*"],
      "outputLogs": "errors-only"
    },
    "clean": {
      "cache": false,
      "outputLogs": "errors-only"
    },
    "artifacts": {
      "cache": false,
      "outputs": ["dist/**/*"],
      "outputLogs": "errors-only"
    },
    "check:artifacts": {
      "cache": false,
      "dependsOn": ["^build", "build"],
      "outputLogs": "errors-only"
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "outputs": ["**/__swc_snapshots__", "**/__snapshots__"],
      "outputLogs": "errors-only"
    },
    "format:check": {
      "outputLogs": "errors-only"
    },
    "format": {
      "cache": false,
      "outputs": [
        "**/src/**/*.{ts,tsx,md,json,jsonc,toml,rs,js,jsx,cjs,mjs,css,scss,html,xml,yml,yaml,mdx}"
      ]
    },
    "bench": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "outputLogs": "errors-only"
    },
    "test:visual": {
      "dependsOn": ["^build", "build"],
      "env": ["PLAYWRIGHT_UPDATE_SNAPSHOTS", "SNAPSHOT_DIR"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH", "CI"],
      "outputs": ["**/.playwright-snapshots/**"],
      "outputLogs": "errors-only"
    },
    "do:nothing": {
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "//#test:coverage:workspace": {
      "inputs": ["$TURBO_DEFAULT$", "**/*.rs", "**/*.toml"],
      "outputLogs": "errors-only"
    },
    "//#test:crates:workspace:regular": {
      "inputs": ["$TURBO_DEFAULT$", "**/*.rs", "**/*.toml"],
      "outputLogs": "errors-only"
    },
    "//#test:crates:workspace:doc": {
      "inputs": ["$TURBO_DEFAULT$", "**/*.rs", "**/*.toml"],
      "outputLogs": "errors-only"
    },
    "//#lint:crates:workspace": {
      "inputs": ["$TURBO_DEFAULT$", "**/*.rs", "**/*.toml"],
      "outputLogs": "errors-only"
    },
    "//#lint:node:type-aware": {
      "inputs": ["$TURBO_DEFAULT$", ".oxlintrc.jsonc", "**/tsconfig*.json"],
      "outputLogs": "errors-only"
    }
  },
  "boundaries": {
    "tags": {
      "rs-compiler": {
        "dependencies": {
          "allow": ["rust-crate"]
        }
      }
    }
  }
}
